{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "local-extensions/flight.ts",
    "local-extensions/departure-review.ts",
    "local-extensions/fuel.ts",
    "local-extensions/persistence.ts",
    "local-extensions/demo-runtime.ts",
    "local-extensions/runtime-host.ts",
    "local-extensions/capability-policy.ts",
    "local-extensions/performance-guards.ts",
    "local-extensions/weather.ts",
    "local-extensions/takeoff/**/*.ts",
    "local-efb/units.ts",
    "local-efb/presentation-mode.ts",
    "local-efb/presentation/types.ts",
    "local-efb/presentation/scenarios.ts",
    "local-efb/presentation/main.ts",
    "local-extensions/planning-schema.ts",
    "local-extensions/planning-context.ts",
    "local-extensions/planning-report.ts",
    "local-extensions/landing/**/*.ts",
    "local-extensions/loading/**/*.ts",
    "local-extensions/fuel-planning/**/*.ts"
  ]
}
