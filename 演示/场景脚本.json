[
  {
    "id": "preflight",
    "name": "典型航班准备",
    "summary": "建档 → 重量 → 页面协同 → 核算报告 → 变更复核 → 检查单",
    "steps": [
      {
        "id": "overview",
        "chapter": "01 / 航班准备",
        "title": "从统一工作台开始",
        "description": "围绕一份航班计划完成签派资料、载荷燃油和参考计算。左侧为正在运行的 Headwind EFB，演示脚本会实际操作这些页面。",
        "watch": "本地场景资料 · 全程可暂停并接管操作",
        "manual": "第 18 章，231–240 页",
        "seconds": 10,
        "actions": [
          {
            "type": "nav",
            "route": "/dashboard",
            "ready": "a[href=\"/dispatch\"]"
          }
        ]
      },
      {
        "id": "flight-import",
        "chapter": "01 / 航班准备",
        "title": "导入航班，建立统一输入",
        "description": "载入 DEMO330 本地航班文件。起飞 ZUTF、目的 ZSPD，250 名旅客，停机坪燃油 30,000 kg。文件经过程序原有的 JSON 解析和字段校验。",
        "watch": "航班号、机场、质量数据同时进入工作台",
        "manual": "19.1–19.4，243–250 页",
        "seconds": 18,
        "actions": [
          {
            "type": "nav",
            "route": "/dispatch/local-flight",
            "ready": ".lf-root [data-field=\"number\"]"
          },
          {
            "type": "button",
            "name": "新建航班"
          },
          {
            "type": "import"
          },
          {
            "type": "expect",
            "values": {
              "flightNumber": "DEMO330",
              "tow": 184500,
              "confirmed": false
            }
          },
          {
            "type": "focus",
            "selector": ".lf-cols"
          }
        ]
      },
      {
        "id": "load-edit",
        "chapter": "01 / 航班准备",
        "title": "人数改变，重量同步变化",
        "description": "将旅客人数从 250 改为 260。每人及行李合计 104 kg，因此载荷和起飞重量同步增加 1,040 kg。重量卡片由实际输入实时计算。",
        "watch": "TOW：184,500 → 185,540 kg",
        "manual": "20.1，255–256 页",
        "seconds": 16,
        "actions": [
          {
            "type": "field",
            "name": "pax",
            "value": "260"
          },
          {
            "type": "expect",
            "values": {
              "tow": 185540,
              "zfw": 156040
            }
          },
          {
            "type": "focus",
            "selector": ".lf-metrics"
          }
        ]
      },
      {
        "id": "load-restore",
        "chapter": "01 / 航班准备",
        "title": "恢复本次演示计划",
        "description": "将旅客人数恢复为 250，检查空重、载荷、零燃油重量和起飞重量之间的关系。本次后续演示采用这份基础计划。",
        "watch": "ZFW 155,000 kg · TOW 184,500 kg",
        "manual": "20.1–20.2，255–258 页",
        "seconds": 12,
        "actions": [
          {
            "type": "field",
            "name": "pax",
            "value": "250"
          },
          {
            "type": "expect",
            "values": {
              "zfw": 155000,
              "tow": 184500
            }
          },
          {
            "type": "focus",
            "selector": ".lf-metrics"
          }
        ]
