        "watch": "计划人数 250 · ZFW 155,000 kg",
        "manual": "20.4，261–262 页",
        "seconds": 15,
        "actions": [
          {
            "type": "nav",
            "route": "/ground/payload",
            "ready": ".lf-groundbar"
